# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# --- Dashboard login ---
# Generate with: npm run hash-password -- "yourStrongPassword"
DASHBOARD_PASSWORD_HASH=

# Random long random string, used to sign the session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Google Sheets (content KPI log) — read-only service account ---
# Confirmed spreadsheet (2026-07-26): "[K-ALBA] + [K-UNIV] Content 관리"
# NOTE: this file also has an "SNS accounts" tab with plaintext social
# media passwords. Sharing this spreadsheet with the service account
# below gives it read access to that tab too (Sheets API permissions are
# per-file, not per-tab) — accepted as a known risk, see
# SECURITY_CHECKLIST.md 3c. Our code only ever requests the named range
# below, never a whole-sheet read.
GOOGLE_SHEETS_SPREADSHEET_ID=1cgYYoJk5O7mJsmA-maZAMbNE8z6PV750-22hjDZvpYw
# Tab name (exact match, including brackets). Change only if the tab is renamed.
GOOGLE_SHEETS_CONTENT_TAB=[K-UNIV]성과
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- GA4 Data API — read-only ---
GA4_PROPERTY_ID=

# --- K-UNIV API (if/when confirmed to exist) — read-only token ---
KUNIV_API_BASE_URL=
KUNIV_API_TOKEN=
